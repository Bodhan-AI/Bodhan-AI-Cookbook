# Bodhan keys: one key per model (https://console.bodhan.ai). Copy to .env and fill in.
# (The Cookbook-wide BODHAN_API_KEY is NOT used here; keys are model-scoped.)
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=

# OpenAI-compatible LLM used only by the agent (planning + English text).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
