# =============================================================================
# Bodhan Tool Server & Task Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# =============================================================================

# --- Bodhan API Keys (one per model) ---
# Get keys from https://console.bodhan.ai/
BODHAN_TRANSCRIBE_KEY=sk-your-transcribe-key-here
BODHAN_TRANSLATE_KEY=sk-your-translate-key-here
BODHAN_SPEAK_KEY=sk-your-speak-key-here
BODHAN_OCR_KEY=sk-your-ocr-key-here

# --- Bodhan API Base URL ---
BODHAN_API_BASE_URL=https://api.bodhan.ai/v1

# --- LLM Configuration (agent brain) ---
# Any OpenAI-compatible endpoint. Examples:
#   OpenAI:  https://api.openai.com/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:    https://api.groq.com/openai/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your-llm-api-key-here

# --- Agent Defaults ---
DEFAULT_MAX_STEPS=30
DEFAULT_MAX_COST_INR=20
DEFAULT_TIMEOUT_SECONDS=120
