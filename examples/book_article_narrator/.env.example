# Copy this file to .env and replace the placeholders. Never commit .env.
# Bodhan issues one key per model.
BODHAN_TRANSLATE_API_KEY=paste_your_real_key_here
BODHAN_SPEAK_API_KEY=paste_your_real_key_here

# Optional: a single key that works for both models (used if the two above are empty)
# BODHAN_API_KEY=paste_your_real_key_here

# Optional: run with a pretend Bodhan (no keys, no cost) by setting this to 1
# NARRATOR_DEMO=1

# Optional: where the history database lives (default: narrator.db in the current folder)
# NARRATOR_DB=narrator.db
