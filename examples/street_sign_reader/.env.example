# OPTIONAL. The app runs 100% standalone and client-side: you can paste your
# keys directly into the in-app Settings (⚙️) modal. Keys are saved securely in your
# browser's local storage and never leave your device except to call api.bodhan.ai.
# Never commit real API keys to git.

BODHAN_BASE_URL=https://api.bodhan.ai

# Virtual Keys from https://console.bodhan.ai (one key per model)
BODHAN_OCR_API_KEY=<your indic-ocr key>
BODHAN_TRANSLATE_API_KEY=<your indic-translate key>
BODHAN_TRANSLITERATE_API_KEY=<your indic-transliterate key>
BODHAN_SPEAK_API_KEY=<your indic-speak key>

# Reserved for master key if enabled
BODHAN_API_KEY=
