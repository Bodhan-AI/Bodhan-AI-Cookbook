# Copy this file to .env and fill in real values. Never commit .env.
# The console issues one key per model, so create five keys and paste each below.
BODHAN_TRANSCRIBE_API_KEY=<your indic-transcribe key>
BODHAN_OCR_API_KEY=<your indic-ocr key>
BODHAN_TRANSLATE_API_KEY=<your indic-translate key>
BODHAN_TRANSLITERATE_API_KEY=<your indic-transliterate key>
BODHAN_SPEAK_API_KEY=<your indic-speak key>

# Fallback for any model that has no key of its own above.
BODHAN_API_KEY=

# Optional: only for `--analyser llm`. Any OpenAI-compatible chat endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
