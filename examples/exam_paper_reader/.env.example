# Copy to .env and fill in. Never commit .env.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# Optional: if your console keys are each limited to one model, set one per model.
# Any that are set take priority over BODHAN_API_KEY for that model.
BODHAN_OCR_KEY=<key with access to indic-ocr>
BODHAN_TRANSLATE_KEY=<key with access to indic-translate>
BODHAN_SPEAK_KEY=<key with access to indic-speak>
BODHAN_TRANSCRIBE_KEY=<key with access to indic-transcribe>
