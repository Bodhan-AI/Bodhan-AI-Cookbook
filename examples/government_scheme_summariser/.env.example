# Copy to .env and fill in. Never commit .env.
# One key that covers all five models:
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# Or one key per model (the console issues each model to a single key).
# Any variable left as a placeholder falls back to BODHAN_API_KEY.
BODHAN_OCR_API_KEY=<key for indic-ocr>
BODHAN_TRANSLATE_API_KEY=<key for indic-translate>
BODHAN_TRANSLITERATE_API_KEY=<key for indic-transliterate>
BODHAN_SPEAK_API_KEY=<key for indic-speak>
BODHAN_TRANSCRIBE_API_KEY=<key for indic-transcribe>

# No other services are needed: this recipe uses Bodhan models only.
