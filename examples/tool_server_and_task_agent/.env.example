# Copy to .env and fill in real keys. Never commit .env.
# Bodhan console: https://console.bodhan.ai/ (one key per model)
BODHAN_TRANSCRIBE_KEY=your-bodhan-transcribe-key
BODHAN_TRANSLATE_KEY=your-bodhan-translate-key
BODHAN_SPEAK_KEY=your-bodhan-speak-key
BODHAN_OCR_KEY=your-bodhan-ocr-key

# General-purpose LLM (OpenAI-compatible). Bodhan runs the agent against
# its own provider; set these to your own endpoint for local runs.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-llm-api-key

# Test-only: BODHAN_MOCK=1 makes the server and agent use the mock Bodhan
# client (canned responses, no network, no cost). Never use for real runs.
# BODHAN_MOCK=1
