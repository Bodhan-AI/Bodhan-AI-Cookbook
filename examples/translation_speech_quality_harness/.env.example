# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Bodhan (console.bodhan.ai) ---
BODHAN_API_KEY=
# Optional per-service keys (override BODHAN_API_KEY for that service)
# BODHAN_TRANSLATE_KEY=
# BODHAN_SPEAK_KEY=
# BODHAN_TRANSCRIBE_KEY=
# BODHAN_BASE_URL=https://api.bodhan.ai
# Optional steady pacing (requests per minute). Without it the client still backs off
# together after any HTTP 429 (Retry-After is shared by all calls to that service).
# BODHAN_TRANSLATE_RPM=

# --- LLM judge ---
# Option A: Claude (official Anthropic SDK). Used when ANTHROPIC_API_KEY is set
# (or LLM_PROVIDER=anthropic). LLM_BASE_URL / LLM_API_KEY are then ignored.
ANTHROPIC_API_KEY=
# LLM_EFFORT=           # optional: low | medium | high (default: the model's own default)
# Option B: any OpenAI-compatible chat API (LLM_PROVIDER=openai)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=              # e.g. claude-haiku-5-5
# Optional: prices so the cost report includes judge spend
# LLM_PRICE_INR_PER_M_INPUT=
# LLM_PRICE_INR_PER_M_OUTPUT=
