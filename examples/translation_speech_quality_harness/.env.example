# Copy to .env and fill in. Never commit .env.
# The Cookbook's shared variable is BODHAN_API_KEY. Bodhan keys are scoped to one model,
# so this recipe uses one key per model instead:
BODHAN_TRANSLATE_KEY=<your Indic-Translate key from console.bodhan.ai>
BODHAN_SPEAK_KEY=<your Indic-Speak key from console.bodhan.ai>
BODHAN_TRANSCRIBE_KEY=<your Indic-Transcribe key from console.bodhan.ai>

# Any OpenAI-compatible chat endpoint, used as the judge.
LLM_BASE_URL=<your LLM base URL, usually ending in /v1>
LLM_MODEL=<your model id>
LLM_API_KEY=<your LLM key>
