# Copy to .env and fill in. Never commit .env.
# Bodhan keys are issued per model at https://console.bodhan.ai
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
# Optional single-key fallback, used for any of the three above that is not set:
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# LLM judge: any OpenAI-compatible endpoint
LLM_BASE_URL=<https://your-provider/v1>
LLM_MODEL=<model id, e.g. openai/gpt-oss-120b>
LLM_API_KEY=<your LLM key>

# Optional tuning (no secrets)
# LLM_EXTRA_BODY={"reasoning_effort": "low"}   # provider-specific extras, passed through as-is
# LLM_TOKENS_PER_MINUTE=7000                   # client-side rate limit for free-tier endpoints
# BODHAN_CONCURRENCY=4
# LLM_CONCURRENCY=4
