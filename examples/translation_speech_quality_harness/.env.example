# Copy to .env and fill in. Never commit .env.

# Bodhan models (fill in; empty = not set), from https://console.bodhan.ai/
# One shared key (the Cookbook convention). Each per-model key below falls back to it when unset.
BODHAN_API_KEY=
# Optional per-model keys (Bodhan issues keys per model); they win over BODHAN_API_KEY.
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_TRANSCRIBE_KEY=

# LLM judge: any OpenAI-compatible endpoint.
# Leave these empty to run without the judge; the report then says the judge was unavailable.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional (not secrets)
# LLM_CONCURRENCY=4                     # parallel judge calls; use 1 on tight tokens-per-minute limits
# BODHAN_BASE_URL=https://api.bodhan.ai # override the Bodhan API host
