# Bodhan model keys (one per model, from https://console.bodhan.ai/)
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_TRANSCRIBE_KEY=
# Optional fallback used for any model that has no key of its own above (a key that is allowed to call all three)
BODHAN_API_KEY=

# General-purpose judge LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# Optional overrides (defaults shown)
# BODHAN_BASE_URL=https://api.bodhan.ai/v1            # speech + transcription
# BODHAN_SPEAK_MODEL=indic-speak
# BODHAN_TRANSCRIBE_MODEL=indic-transcribe
# BODHAN_SPEAK_VOICE=Kavya                            # default voice
# BODHAN_SPEAK_VOICE_TA=                              # per-language voice, if the default does not suit
