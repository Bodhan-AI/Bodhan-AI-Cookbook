# One shared key for all four Bodhan models, used for any model whose own key below is unset (Cookbook convention).
BODHAN_API_KEY=your-key
# Or one key per model:
BODHAN_TRANSCRIBE_KEY=your-key
BODHAN_TRANSLATE_KEY=your-key
BODHAN_SPEAK_KEY=your-key
BODHAN_OCR_KEY=your-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-tool-calling-model
LLM_API_KEY=your-key

# Optional server settings (the agent sets these itself; set them when you run `python -m bodhan_mcp` alone)
# BODHAN_WORKDIR=.bodhan_work           # where tools write outputs and the cost ledger
# BODHAN_INPUT_DIRS=                    # colon-separated files/folders the server may read; unset = any readable file
# BODHAN_MAX_COST_INR=                  # hard spending cap enforced before every paid call
# BODHAN_CACHE_DIR=.bodhan_cache        # persistent cache: identical paid calls are never repeated
