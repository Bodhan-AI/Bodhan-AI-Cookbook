# Copy to .env and fill in. Never commit .env.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai
# chat (default) | auto | plain. Use auto or plain once POST /transliterate is live; see README.
BODHAN_TRANSLIT_ROUTE=chat

