# Bodhan AI API Credentials (get your keys at https://console.bodhan.ai)
# Bodhan provides per-model keys; enter the ones you plan to use:

BODHAN_API_KEY_OCR=your_indic_ocr_key_here
BODHAN_API_KEY_TRANSLATE=your_indic_translate_key_here
BODHAN_API_KEY_TTS=your_indic_speak_key_here
BODHAN_API_KEY_STT=your_indic_transcribe_key_here
BODHAN_API_KEY_TRANSLITERATE=your_indic_transliterate_key_here

# Universal fallback key (if using a single shared key):
BODHAN_API_KEY=your_global_key_here
