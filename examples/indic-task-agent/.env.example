# Hugging Face Access Token (Used by vLLM and scripts to pull models)
HF_TOKEN=hf_your_token_here

# Bodhan Models Base URL (Gateway on port 8000)
BODHAN_BASE_URL=http://localhost:8000/v1

# Bodhan Hosted API Keys (Used when evaluating against hosted Bodhan cloud)
BODHAN_TRANSCRIBE_KEY=your_bodhan_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_bodhan_translate_key_here
BODHAN_SPEAK_KEY=your_bodhan_speak_key_here
BODHAN_OCR_KEY=your_bodhan_ocr_key_here

# Local Orchestrator LLM (Served by vLLM on port 8005)
LLM_BASE_URL=http://localhost:8005/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=dummy
