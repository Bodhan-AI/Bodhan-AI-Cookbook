# ---- Bodhan.AI (keys are per model: console.bodhan.ai/dashboard) ----
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
# BODHAN_API_KEY=            # optional fallback used for any key left empty
BODHAN_BASE_URL=https://api.bodhan.ai

# Rate limits, applied to EACH model key (retries count against the limit)
BODHAN_RPM=50
BODHAN_CONCURRENCY=2
BODHAN_MAX_RETRIES=6
# Per-model overrides (default: BODHAN_RPM). What Bodhan actually enforced in testing (Nov 2026,
# sliding 60 s window per key): translate ~16/min (it advertises 120), speech ~8/min (publishes
# nothing). Stay just below, so the app paces itself instead of getting locked out by 429s.
# BODHAN_TRANSCRIBE_RPM=
BODHAN_TRANSLATE_RPM=15
BODHAN_SPEAK_RPM=7
# true = one limiter shared by all three keys (use if limits are per account)
BODHAN_SHARED_LIMITER=false

# ---- Speech recognition backend ----
# hosted = Bodhan's API (default). local = the same Indic-Transcribe model on this PC's NVIDIA GPU:
# no per-second billing or rate limits, but slower per sentence on a 4 GB laptop GPU. Needs CUDA torch,
# requirements-local-asr.txt and the weights (README). BODHAN_TRANSCRIBE_KEY is then optional.
ASR_BACKEND=hosted
# LOCAL_ASR_MODEL=models/indic-transcribe-core
# Local only: live captions while someone is still talking, refreshed this often (0 = off).
# Each refresh is one translation request, sent only while half of BODHAN_TRANSLATE_RPM stays free.
LIVE_CAPTION_INTERVAL_S=2

# ---- Languages ----
MY_LANGUAGE=en          # you speak this; subtitles appear in it
THEIR_LANGUAGE=hi       # the meeting speaks this; your translated voice uses it
SUBTITLE_SCRIPT=native  # native | roman | codemix (ignored when MY_LANGUAGE=en)
# TTS_VOICE=Kavya       # defaults to a voice recorded in THEIR_LANGUAGE
# TTS_STYLE=            # e.g. "Customer Care", "news"; empty = neutral

# ---- Devices / controls ----
PTT_KEY=ctrl_r          # hold to talk; any pynput Key name (ctrl_r, alt_r, f9, scroll_lock)
# MIC_DEVICE=           # substring of your mic's name; default = Windows default mic
CABLE_DEVICE=CABLE Input
MONITOR_TTS=false       # also play your translated voice in your own headphones

# ---- Latency / segmentation ----
SUBTITLE_DEADLINE_S=15  # give up on a subtitle (incl. retries) after this long
INTERPRET_DEADLINE_S=20
CAPTION_HOLD_S=8
# Optional: also SPEAK their translated subtitles to you (off by default; also a right-click toggle).
# DUB_DEVICE must be an output the app does NOT listen to (not Windows' default output, where the
# meeting plays, and not VB-Cable), e.g. headphones while the meeting plays on speakers.
DUB_INCOMING=false
# DUB_DEVICE=Headphones
# DUB_VOICE=Kavya            # default: a voice for MY_LANGUAGE
SESSION_RECORD=true         # save each meeting's transcript (JSONL, Markdown, SRT); false = keep nothing
SESSION_DIR=out/sessions
SUBTITLE_MERGE_PAUSE_S=1.5  # a subtitle after a shorter pause continues the previous one (0 = off)
VAD_THRESHOLD=0.5
VAD_END_SILENCE_MS=600  # pause that ends an utterance
VAD_SOFT_MAX_S=8        # after this much speech, a 200 ms pause is enough to cut
VAD_HARD_MAX_S=25       # must stay < 30 (Bodhan ASR limit)
