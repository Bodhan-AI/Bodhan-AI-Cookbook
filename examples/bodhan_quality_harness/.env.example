# Copy to .env and fill in. Never commit .env.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# Optional: per-model keys, if your console account scopes them separately.
# BODHAN_TRANSLATE_KEY=
# BODHAN_SPEAK_KEY=
# BODHAN_TRANSCRIBE_KEY=

# Optional model overrides (these are the ids the API accepts)
# BODHAN_TRANSLATE_MODEL=indic-translate
# BODHAN_SPEAK_MODEL=indic-speak
# BODHAN_TRANSCRIBE_MODEL=indic-transcribe

# Judge LLM: any OpenAI-compatible endpoint. Sarvam is what the demo used.
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b
LLM_API_KEY=
