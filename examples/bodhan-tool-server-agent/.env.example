# ==============================================================================
# Bodhan Tool Server & Task Agent Configuration
# DO NOT commit the actual .env file or real secrets to version control.
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Configuration (OpenAI-compatible endpoint for Planning & Orchestration)
# Note: The LLM plans, routes tools, writes English summaries, and judges results.
# It NEVER translates Indian languages, transcribes audio, reads images, or speaks.
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here

# ------------------------------------------------------------------------------
# Bodhan AI API Credentials (https://api.bodhan.ai)
# You can supply a single unified key or granular per-service keys.
# ------------------------------------------------------------------------------
BODHAN_BASE_URL=https://api.bodhan.ai/v1
BODHAN_API_KEY=your_bodhan_unified_api_key_here

# Optional granular keys (override BODHAN_API_KEY if set)
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=

# ------------------------------------------------------------------------------
# Pricing Configuration (in Indian Rupees - INR)
# Default official Bodhan.AI rates
# ------------------------------------------------------------------------------
# Indic-Transcribe: ₹0.10 per minute of audio
BODHAN_PRICE_TRANSCRIBE_PER_MIN_INR=0.10

# Indic-Translate: ₹0.20 per 10,000 output tokens
BODHAN_PRICE_TRANSLATE_PER_10K_TOKENS_INR=0.20

# Indic-Speak: ₹6.00 per 10,000 characters
BODHAN_PRICE_SPEAK_PER_10K_CHARS_INR=6.00

# Indic-OCR: ₹0.20 per image / document page
BODHAN_PRICE_OCR_PER_PAGE_INR=0.20

# ------------------------------------------------------------------------------
# Execution & Caching Settings
# ------------------------------------------------------------------------------
BODHAN_CACHE_ENABLED=true
BODHAN_CACHE_DIR=.cache/bodhan
BODHAN_REQUEST_TIMEOUT_SEC=60
BODHAN_MAX_CONCURRENCY=5
BODHAN_MAX_RETRIES=3
