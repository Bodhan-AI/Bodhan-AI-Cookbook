# Bodhan uses separate keys per hosted model.
BODHAN_TRANSCRIBE_KEY=<your Bodhan transcription key>
BODHAN_TRANSLATE_KEY=<your Bodhan translation key>
BODHAN_TRANSLITERATE_KEY=<your Bodhan transliteration key>
BODHAN_SPEAK_KEY=<your Bodhan speech key>
BODHAN_OCR_KEY=<your Bodhan OCR key>
BODHAN_BASE_URL=https://api.bodhan.ai
BODHAN_CACHE_BACKEND=redis
BODHAN_REDIS_AUTOSTART=true
BODHAN_REDIS_URL=redis://localhost:6379/0
BODHAN_CACHE_TTL_SECONDS=86400
# Maximum retries for rate limiting or connection-establishment timeouts.
BODHAN_MAX_RETRIES=2
# Server-wide limit on simultaneous outbound Bodhan HTTP requests.
BODHAN_MAX_CONCURRENCY=4
# Cached file IDs stay valid while files remain in this folder; oldest files
# for each user are evicted when the configured limit is exceeded.
BODHAN_ARTIFACT_MAX_FILES=20
# Optional; defaults to ~/.cache/bodhan-setu/artifacts
BODHAN_ARTIFACT_DIR=
# Optional; 0 selects an available loopback port automatically.
BODHAN_ARTIFACT_HTTP_PORT=0
# Optional MCP transport configuration. HTTP requires a non-empty bearer token.
BODHAN_MCP_TRANSPORT=stdio
BODHAN_MCP_HOST=127.0.0.1
BODHAN_MCP_PORT=8000
BODHAN_MCP_HTTP_TOKEN=
# Optional; model audio cache files must outlive the Redis cache TTL.
BODHAN_MODEL_CACHE_ARTIFACT_DIR=

# OpenAI-compatible planner endpoint. The task agent requires all three.
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=<your-tool-calling-model>
LLM_API_KEY=<your-planner-api-key>
# Optional planner request timeout in seconds.
LLM_TIMEOUT_SECONDS=120
