# Copy to web/.env.local and adjust. Both are optional.

# Base URL of the FastAPI backend. Leave empty (default) when the backend serves
# this app from web/dist on the same origin, or when using `npm run dev`
# (Vite proxies /api and /health to http://localhost:8000).
# Set it only if the API lives on another origin, e.g. https://calls.example.com
# (the backend must then allow CORS and expose Content-Disposition).
VITE_API_BASE_URL=

# Shared app key. When set, it is sent as the X-App-Key header on every API
# request, including export downloads. Must match the backend's configured key.
# Note: anything in VITE_* is embedded in the built JavaScript and visible to users.
VITE_APP_KEY=
