# Copy to .env and fill in. Never commit .env.

# --- Bodhan (required) — get keys at https://console.bodhan.ai
# One key for every model, or a separate key per model (keys can be scoped to one model).
BODHAN_API_KEY=your_bodhan_api_key_here
BODHAN_TRANSCRIBE_API_KEY=
BODHAN_TRANSLATE_API_KEY=
# Only for scripts/make_sample_call.py (indic-speak)
BODHAN_SPEAK_API_KEY=
# Client-side cap on Bodhan requests per minute (0 = no cap; keys seen so far allow 120/min, 10 parallel).
# Without a cap, long calls hit Bodhan's rate limit (429) — see README "Rate limits (429 errors)".
BODHAN_RPM=50
BODHAN_CONCURRENCY=2
# 6 retries back off ~51 s in total, enough to outlast a 1-minute rate-limit window
BODHAN_MAX_RETRIES=6

# --- AI summary and sentiment (optional) — Sarvam LLM, keys at https://dashboard.sarvam.ai
# Empty = off: calls get no summary or sentiment, everything else works as before.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# low | high | max | none. Reasoning tokens count against SARVAM_MAX_TOKENS.
SARVAM_REASONING_EFFORT=low
# Answer + reasoning budget. The Starter plan allows up to 4096.
SARVAM_MAX_TOKENS=4096
# Pay-as-you-go allows 60 requests/min for sarvam-105b; one call = one request.
SARVAM_RPM=0
# Fallback when Sarvam fails (error, no credits, cut-off or unusable answer). Keys at https://platform.claude.com
# With only this key set, Claude does every analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Claude Opus 5.5 always thinks; this sets how much)
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000

# --- Speaker diarization (optional, see README "Speaker diarization")
# none     = off
# nemotron = NVIDIA Nemotron-3-Diarization on this machine's GPU. Needs `pip install -r requirements-diarization.txt`
#            and an NVIDIA GPU with CUDA. Without one it switches itself off at startup and logs why.
DIARIZATION_PROVIDER=none
# Smallest total GPU memory (GB) to use the model on. It needs about 0.5 GB; 2 leaves headroom.
DIARIZATION_MIN_VRAM_GB=2

# --- Limits
MAX_FILE_MB=50
MAX_DURATION_SECONDS=1800
RESULT_TTL_SECONDS=3600
MAX_CONCURRENT_JOBS=2

# --- App -> backend
# Shared key the app must send in the X-App-Key header. Leave empty for local development.
# It only keeps casual traffic out; it is not a user login.
APP_KEY=
# Comma-separated origins allowed to call the API from another origin (e.g. http://localhost:5173).
# Not needed when the web app is served by the backend or through the Vite dev proxy.
CORS_ORIGINS=
TIMEZONE=Asia/Kolkata
