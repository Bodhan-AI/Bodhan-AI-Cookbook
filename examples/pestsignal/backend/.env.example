# PestSignal Environment Configuration
# Copy this file to .env and configure your secrets

# Bodhan AI API Credentials (from https://console.bodhan.ai)
BODHAN_TRANSCRIBE_API_KEY=your_bodhan_transcribe_key_here
BODHAN_TRANSLATE_API_KEY=your_bodhan_translate_key_here
BODHAN_BASE_URL=https://api.bodhan.ai

# Security & Authentication
SECRET_KEY=generate_a_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./pestsignal.db

# Storage
UPLOAD_DIR=./uploads/audio
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
