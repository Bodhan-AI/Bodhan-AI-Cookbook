# OPTIONAL. The extension does not use this file: you paste your keys into the
# extension's Settings page. A .env is needed only to run `npm run check:live`, which
# tests your keys against the real API from a terminal. Never commit .env.

BODHAN_BASE_URL=https://api.bodhan.ai

# Bodhan keys currently work with one model each: create one key per model on
# https://console.bodhan.ai (Virtual Keys).
BODHAN_TRANSLATE_API_KEY=<your indic-translate key>
# For read-aloud; leave empty to skip the speech check
BODHAN_SPEAK_API_KEY=<your indic-speak key>

# Reserved for when Bodhan issues one key for several models: used for any key above
# left empty. Leave it empty today.
BODHAN_API_KEY=
