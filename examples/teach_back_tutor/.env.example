# Copy to .env and fill in. Never commit .env.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# Optional: if the console gave you one key per model, set these instead.
# Each falls back to BODHAN_API_KEY when empty.
BODHAN_OCR_KEY=
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_TRANSLITERATE_KEY=
BODHAN_SPEAK_KEY=

# Companion LLM (reasoning only: lesson card, dialogue, scoring).
# Any OpenAI-compatible endpoint. Leave LLM_BASE_URL empty for OpenAI.
LLM_API_KEY=<your LLM API key>
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Optional: lower reasoning effort for faster turns (e.g. minimal, low)
LLM_REASONING_EFFORT=
# Gemini instead (free tier, 20 req/day on flash):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_REASONING_EFFORT=minimal

# Groq instead (fast, generous free tier):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_REASONING_EFFORT=
