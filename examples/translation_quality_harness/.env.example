# Copy to .env and fill in. Never commit .env.
# Per-model Bodhan keys from https://console.bodhan.ai (each falls back to BODHAN_API_KEY when unset).
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_API_KEY=<optional single key used for any model without its own key>
BODHAN_BASE_URL=https://api.bodhan.ai

# Any OpenAI-compatible chat-completions endpoint for the LLM judge (base URL up to, not including, /chat/completions).
LLM_BASE_URL=<for example https://api.deepseek.com/v1>
LLM_MODEL=<for example deepseek-flash>
LLM_API_KEY=<your LLM key>
