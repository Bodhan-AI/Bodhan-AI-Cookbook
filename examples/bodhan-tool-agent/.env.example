# Copy to .env and fill in with your real keys. Never commit .env.
# BODHAN_API_KEY is unused by this recipe's code (required as a placeholder by scripts/validate_recipe.py):
# BODHAN_API_KEY=<unused; use the four per-model keys below>

# Bodhan Model API Keys (from https://console.bodhan.ai)
BODHAN_TRANSCRIBE_KEY=your_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_translate_key_here
BODHAN_SPEAK_KEY=your_speak_key_here
BODHAN_OCR_KEY=your_ocr_key_here

# OpenAI-compatible LLM Configuration for Task Agent
# Compatible with any OpenAI-compatible endpoint (e.g. local vLLM, Ollama, LiteLLM, or cloud endpoints).
# LLM_BASE_URL has no default and must be explicitly configured.
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_key_here

# LLM Timeout (seconds) & Retries (predictable upper bound)
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1
