# Copy to .env and fill in with your real keys. Never commit .env.
# BODHAN_API_KEY is replaced by per-model keys below:
# BODHAN_API_KEY=<unused; use per-model keys>

# Bodhan Model API Keys (from https://console.bodhan.ai)
BODHAN_TRANSCRIBE_KEY=your_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_translate_key_here
BODHAN_SPEAK_KEY=your_speak_key_here
BODHAN_OCR_KEY=your_ocr_key_here

# OpenAI-compatible LLM Configuration for Task Agent
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_key_here

# LLM Timeout (seconds) & Retries (predictable upper bound)
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1
