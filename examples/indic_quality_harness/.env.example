# Copy to .env and fill in. Never commit .env.

# One key for every Bodhan service (from console.bodhan.ai) ...
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
# ... or one key per service. A service-specific key wins over BODHAN_API_KEY.
BODHAN_TRANSLATE_API_KEY=
BODHAN_SPEAK_API_KEY=
BODHAN_TRANSCRIBE_API_KEY=

BODHAN_BASE_URL=https://api.bodhan.ai

# Per-unit prices used by --max-cost-inr to estimate spend. The defaults in
# src/bodhan_eval/cost.py are placeholders, not Bodhan pricing: copy the
# real rates from your console.
BODHAN_TRANSLATE_INR_PER_1K_OUTPUT_TOKENS=
BODHAN_SPEAK_INR_PER_1K_CHARS=
BODHAN_TRANSCRIBE_INR_PER_MINUTE=

# Companion service: the --llm-judge flag uses a local Ollama server
# (no key). Its URL and model are CLI flags: --ollama-url, --judge-model.
