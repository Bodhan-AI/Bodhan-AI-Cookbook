# Backend for Render / Fly / any container host: API only (the UI is served by Vercel, but / also works).
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 libfribidi0 fonts-noto-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt
COPY src ./src
RUN pip install --no-cache-dir --no-deps -e .
ENV BODHAN_DUB_WEB_DATA=/data PYTHONUNBUFFERED=1
CMD ["sh", "-c", "python -m bodhan_dub.web --host 0.0.0.0 --port ${PORT:-8000}"]
