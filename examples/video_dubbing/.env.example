# Bodhan API keys (issued per model in the Bodhan console). Placeholders only: never commit real keys.
BODHAN_TRANSCRIBE_KEY=your-indic-transcribe-key
BODHAN_TRANSLATE_KEY=your-indic-translate-key
BODHAN_SPEAK_KEY=your-indic-speak-key
# Optional: Indic-OCR key, only for --ocr / "Translate on-screen text". Without it on-screen text is skipped and the dub continues.
# BODHAN_OCR_KEY=your-indic-ocr-key
# BODHAN_OCR_PRICE_PER_IMAGE=0     # INR per image if you want OCR cost counted in report.json (the docs do not publish a price)
# Optional: one key for all models (used when a per-model key is not set)
# BODHAN_API_KEY=your-key

# Any OpenAI-compatible LLM. It only judges and edits English; it never writes Indian-language text.
# Leave unset to run with deterministic fallbacks (no LLM).
# LLM_CONCURRENCY=2      # parallel LLM calls (languages share one LLM)
# LLM_MAX_ATTEMPTS=6     # a 429/5xx waits (Retry-After, else backoff) and retries before the decision falls back
# LLM_BACKOFF=2.0
# LLM_BREAKER=3          # after this many calls in a row exhaust their retries the LLM is switched off for the run (fallbacks), and the reason is in report.json
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_MODEL=your-model-name
LLM_API_KEY=your-llm-key

# Optional tuning
# BODHAN_DUB_CER_FAIL=0.35        # back-transcription error rate above which a line is retried
# BODHAN_DUB_WEB_DATA=./webdata   # where the web UI stores projects
