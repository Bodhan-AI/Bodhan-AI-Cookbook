# Copy to .env and fill in. Never commit .env.

# Bodhan keys are issued per model at https://console.bodhan.ai.
# Any per-model key left empty falls back to BODHAN_API_KEY.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_BASE_URL=https://api.bodhan.ai

# Companion LLM (the orchestrator's "brain"): any OpenAI-compatible endpoint.
# It plans, merges sentence fragments, builds glossaries and judges quality.
# It never transcribes, translates into Indian languages, or speaks.
LLM_BASE_URL=<https://your-llm-provider/v1>
LLM_MODEL=<model name>
LLM_API_KEY=<your LLM key>
# Optional. Sent only when set, and dropped automatically if the provider rejects them.
# Reasoning models can spend the whole token budget thinking and never answer: use `low`, or
# `none` where the model allows switching reasoning off. Leave it empty for non-reasoning models.
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=
