# Copy to .env and fill in. Never commit .env.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# Optional per-service key overrides (falls back to BODHAN_API_KEY if unset)
# BODHAN_TRANSCRIBE_API_KEY=
# BODHAN_TRANSLATE_API_KEY=
# BODHAN_SPEAK_API_KEY=

# Optional pipeline parameters
BODHAN_DEFAULT_VOICE=Kavya
BODHAN_MIN_SPEEDUP=0.85
BODHAN_MAX_SPEEDUP=1.20
BODHAN_MAX_CONDENSATION_RETRIES=2
BODHAN_MAX_WORKERS=2
BODHAN_TARGET_LUFS=-16.0
BODHAN_TIMELINE_TOLERANCE_MS=100.0
BODHAN_SEGMENT_ALIGNMENT_TOLERANCE_MS=300.0
