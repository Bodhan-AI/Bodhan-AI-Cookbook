# Copy to .env and fill in. Never commit .env.

# Bodhan keys (console.bodhan.ai). Keys are model-scoped: each works only with its own model.
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
# Optional: one key that works for every model. Used for any of the three above that is not set.
# BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>

# LLM: any OpenAI-compatible chat endpoint. It only edits and judges English text; it never writes
# Indian-language text. All three are required together.
LLM_BASE_URL=<https://your-provider.example/v1>
LLM_MODEL=<model id>
LLM_API_KEY=<your LLM key>
