# Copy to .env and fill in. Never commit .env.

# Bodhan keys, one per model (console.bodhan.ai).
# BODHAN_API_KEY is used for any model whose own key is not set.
BODHAN_API_KEY=<your Bodhan API key>
BODHAN_TRANSCRIBE_KEY=<indic-transcribe key>
BODHAN_TRANSLATE_KEY=<indic-translate key>
BODHAN_SPEAK_KEY=<indic-speak key>
BODHAN_BASE_URL=https://api.bodhan.ai

# Any OpenAI-compatible LLM. Optional: without it the run still finishes, with raw transcript
# sentences and long lines sped up instead of shortened. Tested with gpt-oss-120b on AWS Bedrock:
LLM_BASE_URL=https://bedrock-runtime.ap-south-1.amazonaws.com/openai/v1
LLM_MODEL=openai.gpt-oss-120b-1:0
LLM_API_KEY=<your LLM key>
# LLM_TIMEOUT=90   # seconds per LLM request
