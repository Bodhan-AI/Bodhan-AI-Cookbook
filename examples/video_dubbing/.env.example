# ---- Bodhan model keys ----
# Never commit the real .env. Copy this file to .env and fill in your keys.
#
# Option A (assignment spec): one key per model.
BODHAN_TRANSCRIBE_KEY=xxxxxxxx
BODHAN_TRANSLATE_KEY=xxxxxxxx
BODHAN_SPEAK_KEY=xxxxxxxx
# Optional, only if you enable the OCR stretch goal:
# BODHAN_OCR_KEY=sk-bodhan-ocr-xxxxxxxx
#
# Option B (Cookbook convention): a single key used for all models. Any model-specific
# key above overrides it; if a model key is unset, BODHAN_API_KEY is used instead.
# BODHAN_API_KEY=sk-bodhan-xxxxxxxx

# Bodhan API base (OpenAI-compatible). Override only if self-hosting.
BODHAN_BASE_URL=https://api.bodhan.ai

# ---- General-purpose LLM "brain" (any OpenAI-compatible chat endpoint) ----
# Used only for text-side decisions: glossary, English condensing, voice/style choice,
# QA/retry judgment. It never writes Indic text, never transcribes, never synthesizes.
# The brain is non-critical: if the LLM is unreachable or rate-limited, the pipeline
# degrades gracefully to deterministic glossary/condense fallbacks.
#
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#              LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free  (any ':free' model; free
#              models share a rate-limited pool — add a provider key for higher limits)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_API_KEY=xxxxxxxx
