# Copy to .env and fill in. Never commit .env.
#
# `make check` fails if a .env exists anywhere in this repository, so the tidy
# place for working keys is outside it:
#
#     mkdir -p ~/.config/bodhan && cp .env.example ~/.config/bodhan/.env
#
# The loader reads, in order: BODHAN_DUB_ENV_FILE, the nearest .env, then
# ~/.config/bodhan/.env.

# Generic Bodhan key. Used for any model whose specific key is unset.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# Per-model keys (optional). Each falls back to BODHAN_API_KEY when empty.
# The *_API_KEY spellings are also accepted.
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=

# Companion LLM — used only for English-side judgement, never for Indic text.
# Any OpenAI-compatible endpoint works.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional tuning. BODHAN_DUB_RPM is the requests-per-minute figure shown in
# the console under the model name; the API does not return it as a header.
# BODHAN_DUB_RPM=120
# BODHAN_DUB_MAX_INFLIGHT=4
# BODHAN_DUB_MAX_ATTEMPTS=4
# BODHAN_DUB_TIMEOUT_S=120
# BODHAN_DUB_CACHE=.cache
# BODHAN_DUB_LOG_LEVEL=INFO
