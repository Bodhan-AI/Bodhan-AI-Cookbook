# BODHAN_API_KEY=  (Cookbook convention; this recipe uses one key per model, as issued by the Bodhan console)
BODHAN_TRANSCRIBE_KEY=your_bodhan_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_bodhan_translate_key_here
BODHAN_SPEAK_KEY=your_bodhan_speak_key_here
BODHAN_OCR_KEY=your_bodhan_ocr_key_here

# Companion LLM (OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=your_gemini_api_key_here
