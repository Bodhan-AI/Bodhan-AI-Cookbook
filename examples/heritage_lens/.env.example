# Copy to .env and edit. NEVER commit .env. This file contains placeholders only.
APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_string_of_32_or_more_characters
DATABASE_URL=sqlite:///./heritagelens.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Bodhan AI ----
BODHAN_BASE_URL=https://api.bodhan.ai

# Option A: one key for all five services
BODHAN_API_KEY=your_bodhan_api_key_here

# Option B: a separate key per service (these override BODHAN_API_KEY when filled in)
BODHAN_TRANSCRIBE_API_KEY=your_indic_transcribe_key_here
BODHAN_TRANSLATE_API_KEY=your_indic_translate_key_here
BODHAN_TRANSLITERATE_API_KEY=your_indic_transliterate_key_here
BODHAN_OCR_API_KEY=your_indic_ocr_key_here
BODHAN_SPEAK_API_KEY=your_indic_speak_key_here
# Values that start with "your_" are treated as "not configured".

# ---- Optional tuning ----
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# TRANSCRIBE_SEGMENT_SECONDS=29
# MAX_AUDIO_BYTES=52428800
