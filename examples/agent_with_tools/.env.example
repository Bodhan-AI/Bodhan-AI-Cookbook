# Bodhan (hosted API). One key per model; only translate is used in this first iteration.
BODHAN_TRANSLATE_KEY=
BODHAN_BASE_URL=https://api.bodhan.ai
# Translate chunking (optional). The API documents no numeric input limit, so chunks are small by
# default and are halved automatically if the API rejects or truncates one.
# TRANSLATE_MAX_CHARS=1500
# TRANSLATE_CONCURRENCY=1

# LLM (any OpenAI-compatible endpoint with tool calling)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Langfuse tracing (optional: tracing is skipped when the keys are missing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
