{
  "_comment": "Golden set for offline agent evals. mode 'stub' = real LLM + real MCP server, paid Bodhan tools replaced by canned results (Rs 0). mode 'live' = everything real (spends credit; only cases with live=true, each capped by max_cost_inr). 'expect' holds the checks; 'expect_live' overrides single keys when live results are not predictable. Paid tools: transcribe_audio, translate_text, speak_text, ocr_document, make_subtitles.",
  "defaults": {
    "max_steps": 15,
    "max_cost_inr": 2.0
  },
  "fixtures": {
    "audio": "sample_data/generated-audio.wav",
    "image": "sample_data/img with hindi text.png",
    "pdf": "sample_data/chapter.pdf"
  },
  "cases": [
    {
      "id": "tamil_audio_summary_from_pdf",
      "source": "assignment",
      "task": "Make a two-minute Tamil audio summary of this chapter",
      "inputs": [
        {
          "name": "chapter.pdf",
          "copy": "pdf"
        }
      ],
      "max_cost_inr": 6.0,
      "live": false,
      "stubs": {
        "ocr_document": {
          "lines": [
            "# Chapter 3: How plants make food",
            "",
            "Plants make food using sunlight, water and carbon dioxide.",
            "",
            "This process is called photosynthesis. It happens in the green parts of the leaf."
          ]
        }
      },
      "expect": {
        "status": [
          "completed"
        ],
        "tool_sequence": [
          "ocr_document",
          "translate_text",
          "speak_text"
        ],
        "tool_counts": {
          "ocr_document": 1,
          "speak_text": 1
        },
        "args": {
          "translate_text": {
            "target_language": "ta"
          },
          "speak_text": {
            "language": "ta"
          }
        },
        "verified_audio": true,
        "no_llm_indic_text": true,
        "no_duplicate_calls": true
      },
      "record": {
        "translate_text": [
          {
            "source": "stub_ocr",
            "target": "ta"
          }
        ]
      }
    },
    {
      "id": "hindi_voicenote_english_srt",
      "source": "assignment",
      "task": "Transcribe this Hindi voice note and give me English subtitles",
      "inputs": [
        {
          "name": "voicenote.wav",
          "copy": "audio"
        }
      ],
      "live": false,
      "stubs": {
        "transcribe_audio": {
          "default_language": "hi"
        }
      },
      "expect": {
        "status": [
          "completed"
        ],
        "tool_sequence": [
          "transcribe_audio",
          "make_subtitles"
        ],
        "tool_counts": {
          "transcribe_audio": 1,
          "make_subtitles": 1
        },
        "args": {
          "transcribe_audio": {
            "language": "hi"
          },
          "make_subtitles": {
            "target_language": "en",
            "output_path": "suffix:.srt"
          }
        },
        "artifact_suffixes_any": [
          ".srt"
        ],
        "no_llm_indic_text": true,
        "no_duplicate_calls": true
      },
      "record": {
        "transcribe_audio": [
          {
            "input": "voicenote.wav"
          }
        ]
      }
    },
