# Bodhan AI API Credentials (get keys at https://console.bodhan.ai/)
BODHAN_BASE_URL=https://api.bodhan.ai
BODHAN_OCR_KEY=your_indic_ocr_key
BODHAN_TRANSLATE_KEY=your_indic_translate_key
BODHAN_SPEAK_KEY=your_indic_speak_key
BODHAN_TRANSCRIBE_KEY=your_indic_transcribe_key

# Optional: Universal key if one key covers all models
# BODHAN_API_KEY=your_universal_key

# General-purpose LLM for English pedagogical narration scripting (OpenAI-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_API_KEY=your_llm_api_key

# Set to 1 to run completely offline with simulated mock responses
# BODHAN_MOCK=1
