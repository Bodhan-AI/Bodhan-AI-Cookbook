# Copy to .env and fill in. Real environment variables take precedence over .env.

# Bodhan keys (https://console.bodhan.ai/). The harness reads one variable per model,
# as the assignment specifies. If one key covers all models, put it in all three.
# Or one key for all three (the Cookbook's convention); a per-model key above wins.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_TRANSLATE_KEY=<Bodhan key for this model, or leave the placeholder to use BODHAN_API_KEY>
BODHAN_SPEAK_KEY=<Bodhan key for this model, or leave the placeholder to use BODHAN_API_KEY>
BODHAN_TRANSCRIBE_KEY=<Bodhan key for this model, or leave the placeholder to use BODHAN_API_KEY>
# Optional, not a secret. Defaults to the hosted API.
# BODHAN_BASE_URL=https://api.bodhan.ai/v1

# Any OpenAI-compatible LLM endpoint, used as the judge.
# Tested with NVIDIA's free API (key from build.nvidia.com, starts with nvapi-):
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_API_KEY=<your LLM provider's API key>

# Optional: request limits per model, <parallel>/<per minute> (defaults suit our keys: Bodhan allowed
# ~7-12 requests/min per model). Raise them if your keys allow more; the runtime projection uses them.
# LIMIT_LLM=8/60
# LIMIT_TRANSLATE=8/120
# LIMIT_SPEAK=8/120
# LIMIT_TRANSCRIBE=8/120
