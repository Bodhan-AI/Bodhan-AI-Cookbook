# Cookbook's generic BODHAN_API_KEY is not used here; this assignment uses model-scoped keys.
# Bodhan model API keys (one per model). Get them from https://console.bodhan.ai/
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_TRANSCRIBE_KEY=

# Bodhan API base (OpenAI-compatible). Override only if the console gives a different base.
BODHAN_BASE_URL=https://api.bodhan.ai/v1

# General-purpose LLM used as the judge / brain (any OpenAI-compatible endpoint).
# Example (Groq free tier, tested):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
# Example (OpenAI): LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
