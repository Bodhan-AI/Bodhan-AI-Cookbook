# Bodhan model keys
# Cookbook validators check for the shared-key name; this app uses separate
# model-specific keys and does not read BODHAN_API_KEY.
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=

# OpenAI-compatible Groq API
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Alternatively, set GROQ_API_KEY instead of LLM_API_KEY when using Groq.
GROQ_API_KEY=
# Optional account-specific Groq limits; defaults to 30 RPM / 8,000 TPM
# for openai/gpt-oss-20b when using Groq.
GROQ_RPM_LIMIT=
GROQ_TPM_LIMIT=
# Set these only if your Groq organization shows separate input/output limits.
GROQ_ITPM_LIMIT=
GROQ_OTPM_LIMIT=
