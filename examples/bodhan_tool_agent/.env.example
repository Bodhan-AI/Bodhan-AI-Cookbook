# Bodhan AI API Credentials (from https://console.bodhan.ai)
BODHAN_API_KEY=your_bodhan_api_key_here
BODHAN_BASE_URL=https://api.bodhan.ai

# Optional capability-specific keys (fallback to BODHAN_API_KEY if unset)
BODHAN_TRANSCRIBE_API_KEY=
BODHAN_TRANSLATE_API_KEY=
BODHAN_TRANSLITERATE_API_KEY=
BODHAN_SPEAK_API_KEY=
BODHAN_OCR_API_KEY=

# Configurable LLM Configuration (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_here

# MCP Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_AUTH_TOKEN=your_mcp_bearer_token_here
