# Bodhan AI API Credentials (get keys from https://console.bodhan.ai)
BODHAN_API_KEY=your_bodhan_api_key_here
BODHAN_BASE_URL=https://api.bodhan.ai

# Optional model-specific keys (falls back to BODHAN_API_KEY if unset)
BODHAN_TRANSCRIBE_KEY=your_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_translate_key_here
BODHAN_SPEAK_KEY=your_speak_key_here
BODHAN_OCR_KEY=your_ocr_key_here

# Companion LLM Configuration (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here

# Optional: Set to 1 to run offline mock mode for testing
BODHAN_MOCK=0
