# Copy to .env and fill in. Never commit .env.

# --- Bodhan (https://console.bodhan.ai) ---
# Keys are issued per model. BODHAN_API_KEY is the fallback for any model key left empty,
# so a single key is enough if it is valid for all four models.
BODHAN_API_KEY=<your Bodhan API key>
BODHAN_TRANSCRIBE_KEY=<your Indic-Transcribe key, or leave empty to use BODHAN_API_KEY>
BODHAN_TRANSLATE_KEY=<your Indic-Translate key, or leave empty to use BODHAN_API_KEY>
BODHAN_SPEAK_KEY=<your Indic-Speak key, or leave empty to use BODHAN_API_KEY>
BODHAN_OCR_KEY=<your Indic-OCR key, or leave empty to use BODHAN_API_KEY>
BODHAN_BASE_URL=https://api.bodhan.ai

# --- Planner LLM (any OpenAI-compatible endpoint with tool calling) ---
# Used only for planning, tool choice, English summaries and judging results.
LLM_BASE_URL=<your OpenAI-compatible base URL, ending in /v1>
LLM_MODEL=<model name, e.g. gpt-4o-mini>
LLM_API_KEY=<your LLM provider key>

# --- Optional tuning (defaults shown) ---
# BODHAN_CACHE_DIR=.bodhan_cache
# BODHAN_CONCURRENCY=4
# Per-model overrides; Indic-Speak and Indic-Transcribe default to 2 because they rate-limit at 4.
# BODHAN_CONCURRENCY_SPEAK=2
# BODHAN_CONCURRENCY_TRANSCRIBE=2
# BODHAN_CALL_TIMEOUT_S=120
# BODHAN_MAX_RETRIES=4
# BODHAN_WORKDIR=bodhan_mcp_out
# BODHAN_MAX_COST_INR=
# BODHAN_ALLOWED_DIRS=

# --- Optional: bearer token for the streamable HTTP transport (python -m bodhan_mcp --http) ---
# BODHAN_MCP_TOKEN=<a long random string you choose>
