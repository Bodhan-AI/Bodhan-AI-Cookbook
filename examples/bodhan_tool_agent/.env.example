# Copy to .env and fill in. Never commit .env.

# --- Bodhan keys (issued per model at https://console.bodhan.ai) ---
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_OCR_KEY=<your indic-ocr key>
# Optional: one key for every model (Cookbook convention). Used for any per-model key left empty.
BODHAN_API_KEY=<optional single Bodhan API key>
BODHAN_BASE_URL=https://api.bodhan.ai

# --- Planner LLM (any OpenAI-compatible endpoint with tool calling) ---
LLM_BASE_URL=<your OpenAI-compatible base URL, ending in /v1>
LLM_MODEL=<model name>
LLM_API_KEY=<your LLM API key>

# --- Optional tuning (defaults shown) ---
# BODHAN_MAX_CONCURRENCY=4          # parallel requests per Bodhan model
# BODHAN_MAX_RETRIES=3              # retries on 429/5xx/timeouts, exponential backoff with jitter
# BODHAN_CACHE_DIR=.bodhan_cache    # content-addressed cache; reruns never repeat paid calls
# BODHAN_CACHE=1                    # set 0 to disable the cache
# BODHAN_MCP_OUTPUT_DIR=bodhan_outputs   # where the standalone server writes files
# BODHAN_MCP_ROOTS=                 # optional os.pathsep-separated folders the server may read
# LLM_TIMEOUT_S=120
# LLM_PRICE_INR_PER_1M_INPUT=0      # set both to count LLM spend toward --max-cost-inr
# LLM_PRICE_INR_PER_1M_OUTPUT=0
# MCP_HTTP_TOKEN=<token>            # only for `python -m bodhan_mcp --transport http`
