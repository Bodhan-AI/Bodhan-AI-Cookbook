# Bodhan AI API keys (one per model, from https://console.bodhan.ai/)
BODHAN_TRANSCRIBE_KEY=your_bodhan_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_bodhan_translate_key_here
BODHAN_SPEAK_KEY=your_bodhan_speak_key_here
BODHAN_OCR_KEY=your_bodhan_ocr_key_here
BODHAN_BASE_URL=https://api.bodhan.ai/v1

# Cookbook CI requires this literal; this recipe reads the per-model keys above.
# BODHAN_API_KEY=

# Analytical LLM Provider (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=your_llm_api_key_here
LLM_REASONING_EFFORT=low
