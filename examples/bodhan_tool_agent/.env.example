# Bodhan keys: https://console.bodhan.ai/
# Option 1 (as the assignment specifies): one key per model.
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=
# Option 2: a single key that has all four models. Used for any model whose own variable above is empty.
BODHAN_API_KEY=

# General-purpose LLM for the agent (any OpenAI-compatible endpoint with tool calling).
# Read from its own variables, separate from the Bodhan keys.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Optional
# BODHAN_API_BASE=https://api.bodhan.ai
# BODHAN_CACHE_DIR=.bodhan_cache
# BODHAN_WORKDIR=.            # root the MCP tools may read/write under (extra roots: BODHAN_EXTRA_ROOTS=dir1:dir2)
# BODHAN_MAX_COST_INR=        # hard cost cap for the MCP server process
