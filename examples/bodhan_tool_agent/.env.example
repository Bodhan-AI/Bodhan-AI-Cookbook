# Copy to .env and fill in. Never commit .env.
# One key for every model (Cookbook convention) ...
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
# ... or one key per model (assignment spec). Per-model keys win when both are set.
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_OCR_KEY=<your indic-ocr key>
BODHAN_BASE_URL=https://api.bodhan.ai

# Companion LLM (any OpenAI-compatible endpoint with tool calling) - the agent's planner.
LLM_BASE_URL=<https://your-llm-provider/v1>
LLM_MODEL=<model name>
LLM_API_KEY=<your LLM key>

# Optional
# BODHAN_CACHE_DIR=.bodhan_cache      # content-addressed cache of every model output
# BODHAN_MAX_PARALLEL=2               # concurrent Bodhan requests
# BODHAN_MCP_TOKEN=<token>            # required for `python -m bodhan_mcp --http`
