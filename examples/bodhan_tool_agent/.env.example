# Bodhan keys from the Bodhan console. Use the key issued for each model.
# Blank compatibility field required by the general Cookbook recipe validator; this recipe does not read it.
BODHAN_API_KEY=
BODHAN_TRANSCRIBE_KEY=your_transcribe_key
BODHAN_TRANSLATE_KEY=your_translate_key
BODHAN_SPEAK_KEY=your_speak_key
BODHAN_OCR_KEY=your_ocr_key

# Gemini planner defaults. Compatible OpenAI-style providers can override the URL and model.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your_gemini_api_key

# LangSmith traces LangChain LLM calls and the standalone MCP tools.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=bodhan-tool-agent
# Optional for non-US regions or self-hosted LangSmith:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

BODHAN_CACHE_DIR=.bodhan-cache
