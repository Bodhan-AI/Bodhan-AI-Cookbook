# Copy to .env and fill in. Never commit .env.
BODHAN_API_KEY=<your fallback Bodhan API key>
BODHAN_TRANSCRIBE_KEY=<your transcription API key>
BODHAN_TRANSLATE_KEY=<your translation API key>
BODHAN_SPEAK_KEY=<your speech API key>
BODHAN_OCR_KEY=<your OCR API key>
BODHAN_BASE_URL=https://api.bodhan.ai
BODHAN_TIMEOUT=60

# Reserved for the later planning agent; do not use these with Bodhan models.
LLM_BASE_URL=<your LLM base URL>
LLM_MODEL=<your LLM model ID>
LLM_API_KEY=<your LLM API key>
