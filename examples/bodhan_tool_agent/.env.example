# Copy to .env and fill in. Never commit .env.

# Bodhan keys, one per model, from https://console.bodhan.ai
BODHAN_TRANSCRIBE_KEY=<your Indic-Transcribe key>
BODHAN_TRANSLATE_KEY=<your Indic-Translate key>
BODHAN_SPEAK_KEY=<your Indic-Speak key>
BODHAN_OCR_KEY=<your Indic-OCR key>
# Optional: one shared key, used for any model whose own key above is empty.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# The agent's LLM: any OpenAI-compatible endpoint with tool calling.
LLM_BASE_URL=<base URL of your LLM provider, ending in /v1>
LLM_MODEL=<model name>
LLM_API_KEY=<your LLM key>

# Optional fallback LLM. If the main one fails (overloaded, rate-limited, down),
# the agent switches to this one for the rest of the run. Set all three, or none.
# LLM_FALLBACK_BASE_URL=<base URL of a second provider>
# LLM_FALLBACK_MODEL=<model name>
# LLM_FALLBACK_API_KEY=<that provider's key>
# A second fallback, used when both of the above are resting:
# LLM_FALLBACK2_BASE_URL=
# LLM_FALLBACK2_MODEL=
# LLM_FALLBACK2_API_KEY=

# Optional tuning
# BODHAN_MAX_PARALLEL=4          # concurrent Bodhan requests
# BODHAN_TIMEOUT_S=120           # per-request timeout
# BODHAN_CACHE_DIR=.bodhan_cache # where model outputs are cached
# Stand-alone MCP server only:
# BODHAN_MCP_ROOTS=/path/to/files            # folders the server may read (default: current folder)
# BODHAN_MCP_OUTPUT_DIR=bodhan_outputs       # where the server writes files
# BODHAN_MCP_MAX_COST_INR=20                 # optional spending cap for the server process
