# Primary Bodhan API Key
BODHAN_API_KEY=your_bodhan_api_key_here

# Specific Model Keys (optional if using master BODHAN_API_KEY)
BODHAN_TRANSCRIBE_KEY=your_indic_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_indic_translate_key_here
BODHAN_SPEAK_KEY=your_indic_speak_key_here
BODHAN_OCR_KEY=your_indic_ocr_key_here
BODHAN_API_BASE_URL=https://api.bodhan.ai/v1

# Companion LLM Planner (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_here
