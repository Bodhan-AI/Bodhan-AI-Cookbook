# ============================================================
# Bodhan Tool Server & Task Agent - Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.
# ============================================================

# --- Bodhan API Key ---
BODHAN_API_KEY=your_bodhan_api_key_here

# --- Bodhan Model-Specific API Keys ---
# Get these from https://console.bodhan.ai/ (one key per model)
BODHAN_TRANSCRIBE_KEY=your_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_translate_key_here
BODHAN_SPEAK_KEY=your_speak_key_here
BODHAN_OCR_KEY=your_ocr_key_here
BODHAN_API_BASE=https://api.bodhan.ai/v1

# --- LLM (Agent Brain) ---
# Use any OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_here
