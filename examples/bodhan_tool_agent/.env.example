# Copy to .env and fill in. Never commit .env.

# Bodhan keys are issued per model at https://console.bodhan.ai
BODHAN_TRANSCRIBE_KEY=<Indic-Transcribe key>
BODHAN_TRANSLATE_KEY=<Indic-Translate key>
BODHAN_SPEAK_KEY=<Indic-Speak key>
BODHAN_OCR_KEY=<Indic-OCR key>
# Optional: one shared key, used for any model whose own key above is empty.
BODHAN_API_KEY=<optional shared Bodhan key>
BODHAN_BASE_URL=https://api.bodhan.ai

# Any OpenAI-compatible endpoint with tool calling (agent only; the MCP server needs no LLM).
LLM_BASE_URL=<https://your-llm-endpoint/v1>
LLM_MODEL=<model name>
LLM_API_KEY=<llm key>

# Optional tuning
# BODHAN_MAX_CONCURRENCY=4
# BODHAN_TIMEOUT_S=90
# BODHAN_WORK_DIR=./bodhan_mcp_out     # MCP server output folder
# BODHAN_MAX_COST_INR=20               # MCP server spend cap
