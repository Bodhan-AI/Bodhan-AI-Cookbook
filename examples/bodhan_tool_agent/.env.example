# --- Bodhan API keys (one per model; create them at https://console.bodhan.ai/) ---
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=
# Optional: one key for everything, used when a per-model key is empty
# BODHAN_API_KEY=

# --- LLM for the agent (any OpenAI-compatible endpoint with tool calling) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- Optional tuning ---
# BODHAN_BASE_URL=https://api.bodhan.ai
# BODHAN_WORK_DIR=./bodhan_work
# BODHAN_CACHE_DIR=./.bodhan_cache
# BODHAN_CONCURRENCY=4
# BODHAN_MAX_COST_INR=
