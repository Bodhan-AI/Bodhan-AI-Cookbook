# ==============================================================================
# Bodhan Tool Server and Task Agent - Environment Configuration Template
# Duplicate this file as .env and fill in your actual credentials.
# NOTE: Never commit your actual .env file or leak API keys.
# ==============================================================================

# Bodhan AI API Keys (https://console.bodhan.ai)
# Hosted API: https://api.bodhan.ai/v1
BODHAN_TRANSCRIBE_KEY=your_bodhan_transcribe_key_placeholder
BODHAN_TRANSLATE_KEY=your_bodhan_translate_key_placeholder
BODHAN_SPEAK_KEY=your_bodhan_speak_key_placeholder
BODHAN_OCR_KEY=your_bodhan_ocr_key_placeholder

# Task Agent LLM Configuration (OpenAI-compatible with tool calling)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=your_llm_api_key_placeholder

# Optional live-call kill switch (paid Bodhan calls are allowed by default when keys are set):
# set BODHAN_ALLOW_LIVE=0 to block all paid calls
