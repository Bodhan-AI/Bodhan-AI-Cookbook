# Bodhan AI API Configuration (never commit real keys)
BODHAN_BASE_URL=https://api.bodhan.ai
BODHAN_TRANSCRIBE_KEY=your_bodhan_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_bodhan_translate_key_here
BODHAN_SPEAK_KEY=your_bodhan_speak_key_here
BODHAN_OCR_KEY=your_bodhan_ocr_key_here

# Optional fallback if you also use a single key in local testing
BODHAN_API_KEY=your_bodhan_api_key_here

# OpenAI-compatible LLM endpoint for planning, routing, English text & verification
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here

# Optional operational defaults
BODHAN_MAX_CONCURRENCY=4
BODHAN_CACHE_DIR=.cache/bodhan
