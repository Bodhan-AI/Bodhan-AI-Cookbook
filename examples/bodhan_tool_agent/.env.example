# Copy to .env and fill in. Never commit .env.

# Bodhan keys, one per model (issued separately at https://console.bodhan.ai).
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_OCR_KEY=<your indic-ocr key>

# Optional: a single key used for any model whose key above is unset.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# Companion LLM (the agent's planner). Any OpenAI-compatible endpoint with tool calling.
LLM_BASE_URL=<https://your-llm-provider/v1>
LLM_MODEL=<model name>
LLM_API_KEY=<your LLM key>

# Optional hard cap on total Bodhan spend per MCP server process, in rupees. Unset = unlimited.
BODHAN_MAX_COST_INR=
