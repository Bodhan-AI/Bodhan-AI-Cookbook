# Copy to .env and fill in. Never commit .env.

# One key per Bodhan model (console.bodhan.ai issues keys per model).
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_OCR_KEY=<your indic-ocr key>
# Optional fallback used for any model whose own key above is empty.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai, optional>
BODHAN_BASE_URL=https://api.bodhan.ai

# Any OpenAI-compatible chat endpoint with tool calling (the agent's brain).
LLM_BASE_URL=<your OpenAI-compatible base URL, ending in /v1>
LLM_MODEL=<model name, e.g. an open-weights model with tool calling>
LLM_API_KEY=<your LLM provider key>

# Optional tuning
# BODHAN_CACHE_DIR=.bodhan_cache
# BODHAN_TIMEOUT_S=120
# BODHAN_MAX_PARALLEL=4
