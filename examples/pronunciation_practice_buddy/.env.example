# Copy to .env and fill in. Never commit .env.
# Each Bodhan key is tied to one model, so this recipe uses one variable per model.
BODHAN_SPEAK_KEY=<key for indic-speak from console.bodhan.ai>
BODHAN_TRANSCRIBE_KEY=<key for indic-transcribe from console.bodhan.ai>
BODHAN_TRANSLITERATE_KEY=<key for indic-transliterate from console.bodhan.ai>
BODHAN_TRANSLATE_KEY=<key for indic-translate from console.bodhan.ai>

# Optional: one key that works for all four models (used when a per-model key is not set).
# BODHAN_API_KEY=<your Bodhan API key>
BODHAN_BASE_URL=https://api.bodhan.ai
