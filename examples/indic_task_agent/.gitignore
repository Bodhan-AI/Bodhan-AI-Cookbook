# Secrets
.env
.env.*
!.env.example

# Environments and caches
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Generated media and run outputs (media stays out of git; see README "Test media")
sample_data/*
!sample_data/.gitkeep
!sample_data/README.md
outputs/*
!outputs/.gitkeep
bodhan_mcp_artifacts/
out/

# Raw run state, traces, tokens and media (scripts/export_runs.py writes the scrubbed evidence)
**/.state/
**/.previous_runs/
.mcp_http_token
server_trace.jsonl
evaluation/runs/**/*.mp3
evaluation/runs/**/*.wav
*.bin
