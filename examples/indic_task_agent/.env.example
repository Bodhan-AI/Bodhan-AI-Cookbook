# Copy to .env and fill in. Never commit .env.
# Bodhan issues one key per model (console.bodhan.ai); each key only works for its own model.
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_OCR_KEY=<your indic-ocr key>
# Optional fallback, used only for a model whose own key above is unset.
BODHAN_API_KEY=<your Bodhan API key>

# Companion LLM (OpenAI-compatible, with tool calling). Writes English only.
LLM_BASE_URL=<https://your-llm-provider/v1>
LLM_MODEL=<model name>
LLM_API_KEY=<your LLM key>
