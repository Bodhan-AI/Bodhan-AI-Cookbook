# Copy to .env and fill in. Never commit .env.
#
# The Bodhan console issues one key per model, so this recipe reads one variable
# per model. The single BODHAN_API_KEY used by other Cookbook recipes is not read here.

# --- Bodhan models (keys from https://console.bodhan.ai) ---
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_OCR_KEY=<your indic-ocr key>
# Optional: only the transliterate_text tool uses it. Leave blank and that tool
# returns a MISSING_API_KEY error; everything else keeps working.
BODHAN_TRANSLITERATE_KEY=<your indic-transliterate key>

# --- LLM: any OpenAI-compatible endpoint with tool calling ---
# The agent reads only these three (plus the optional LLM_EXTRA_BODY).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=<your OpenAI API key>
# Optional JSON merged into every chat request, for provider-specific settings.
# gpt-6-luna only allows function calling on Chat Completions with reasoning off:
LLM_EXTRA_BODY={"reasoning_effort": "none"}
#
# Other providers, for example Anthropic's OpenAI-compatible endpoint:
#   LLM_BASE_URL=https://api.anthropic.com/v1/
#   LLM_MODEL=claude-sonnet-5-5
#   LLM_EXTRA_BODY=
