# Copy to .env and fill in. Never commit .env.

# --- Bodhan (https://console.bodhan.ai) ---
# One key for every model, as the Cookbook convention expects...
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
# ...or one key per model (each one, when set, wins over BODHAN_API_KEY).
BODHAN_TRANSCRIBE_KEY=<optional per-model key>
BODHAN_TRANSLATE_KEY=<optional per-model key>
BODHAN_SPEAK_KEY=<optional per-model key>
BODHAN_OCR_KEY=<optional per-model key>
BODHAN_BASE_URL=https://api.bodhan.ai

# --- LLM for the agent's planning (any OpenAI-compatible endpoint with tool calling) ---
LLM_BASE_URL=<e.g. https://your-provider.example/v1>
LLM_MODEL=<model name>
LLM_API_KEY=<your LLM key>
# Shorten older context above this many prompt tokens. Groq free tier (8k tokens/minute): use 5500.
# LLM_MAX_PROMPT_TOKENS=16000

# --- Optional tuning (defaults shown) ---
# BODHAN_MAX_CONCURRENCY=4
# BODHAN_HTTP_TIMEOUT_S=90
# BODHAN_MAX_RETRIES=4
# BODHAN_CACHE_DIR=.bodhan_cache
# BODHAN_MCP_OUTPUT_DIR=outputs/mcp
