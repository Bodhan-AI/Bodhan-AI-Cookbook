# Copy to .env and fill in. Never commit .env.

# --- Bodhan (https://console.bodhan.ai) ---------------------------------
# Shared key used as a fallback when a per-model key below is not set.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# Per-model keys (the console issues one key per model).
BODHAN_TRANSCRIBE_KEY=<indic-transcribe key>
BODHAN_TRANSLATE_KEY=<indic-translate key>
BODHAN_SPEAK_KEY=<indic-speak key>
BODHAN_OCR_KEY=<indic-ocr key>

# --- Companion LLM (agent brain; any OpenAI-compatible endpoint) ---------
LLM_BASE_URL=<https://your-llm-provider/v1>
LLM_MODEL=<model name that supports tool calling>
LLM_API_KEY=<your LLM API key>
