# Create the model-specific keys you need in the Bodhan console.
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_OCR_KEY=<your indic-ocr key>
# Optional fallback for older shared-key Cookbook setups; current Bodhan keys are per model.
BODHAN_API_KEY=<optional legacy shared key>
BODHAN_BASE_URL=https://api.bodhan.ai

# OpenAI-compatible planner. Use a provider you control; never put keys in source.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=<your tool-calling model>
LLM_API_KEY=<your planner key>

# Safety limits. Budget is enforced only when API responses provide cost_inr;
# unknown billing is surfaced as unmetered and never represented as a known cost.
MAX_STEPS=8
MAX_BUDGET_INR=10
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=2
