# Copy to .env and fill in. Never commit .env.

# Bodhan keys: one per model, or set BODHAN_API_KEY once and leave the others empty.
BODHAN_API_KEY=<your-bodhan-api-key>
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=
BODHAN_BASE_URL=https://api.bodhan.ai

# Where cache and artifacts are written (default: ~/.cache/bodhan_mcp)
BODHAN_WORK_DIR=

# LLM used by the task agent (any OpenAI-compatible endpoint with tool calling).
LLM_BASE_URL=<your-llm-base-url>
LLM_MODEL=<your-llm-model>
LLM_API_KEY=<your-llm-api-key>
