# Bodhan keys, one per model, from https://console.bodhan.ai
BODHAN_TRANSCRIBE_KEY=your_transcribe_key
BODHAN_TRANSLATE_KEY=your_translate_key
BODHAN_SPEAK_KEY=your_speak_key
BODHAN_OCR_KEY=your_ocr_key
# Optional: one key for every model, used when a per-model key above is empty.
BODHAN_API_KEY=your_bodhan_key_here

# The agent's LLM: any OpenAI-compatible endpoint with tool calling.
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_MODEL=your-model-name
LLM_API_KEY=your_llm_key

# Optional tuning (defaults shown)
# BODHAN_BASE_URL=https://api.bodhan.ai
# BODHAN_MAX_PARALLEL=4
# BODHAN_TIMEOUT_S=90
# BODHAN_CACHE_DIR=~/.cache/bodhan_mcp
# BODHAN_MCP_WORKDIR=bodhan_work
