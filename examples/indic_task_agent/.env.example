# Copy to .env and fill in. Never commit .env.

# Bodhan keys, one per model (from https://console.bodhan.ai).
BODHAN_TRANSCRIBE_KEY=<your-indic-transcribe-key>
BODHAN_TRANSLATE_KEY=<your-indic-translate-key>
BODHAN_SPEAK_KEY=<your-indic-speak-key>
BODHAN_OCR_KEY=<your-indic-ocr-key>
# Optional fallback used for any model whose key above is not set (Cookbook convention).
BODHAN_API_KEY=<optional-single-key-for-all-models>

# LLM used by the task agent: any OpenAI-compatible endpoint with tool calling.
LLM_BASE_URL=<your-llm-base-url>
LLM_MODEL=<your-llm-model>
LLM_API_KEY=<your-llm-api-key>

# Optional, not secrets:
# BODHAN_BASE_URL=https://api.bodhan.ai
# BODHAN_WORK_DIR=~/.cache/bodhan_mcp      (MCP server cache and outputs)
