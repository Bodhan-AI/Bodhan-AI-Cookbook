# Copy to .env and fill in. Never commit .env.
# Per-model Bodhan keys (console.bodhan.ai). Any that is unset falls back to BODHAN_API_KEY.
BODHAN_API_KEY=<optional shared Bodhan key>
BODHAN_TRANSCRIBE_KEY=<Indic-Transcribe key>
BODHAN_TRANSLATE_KEY=<Indic-Translate key>
BODHAN_SPEAK_KEY=<Indic-Speak key>
BODHAN_OCR_KEY=<Indic-OCR key>
BODHAN_BASE_URL=https://api.bodhan.ai

# The agent's planner: any OpenAI-compatible chat/completions endpoint.
LLM_BASE_URL=<https://your-provider/v1>
LLM_MODEL=<model name>
LLM_API_KEY=<llm key>

# Optional knobs
BODHAN_MAX_CONCURRENCY=2
BODHAN_TIMEOUT_S=60
BODHAN_CACHE_DIR=.bodhan-cache
BODHAN_MCP_TOKEN=<bearer token, only for --transport streamable-http>
