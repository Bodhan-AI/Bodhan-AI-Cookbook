# Copy to .env and fill in. Never commit .env.
# Bodhan keys are issued per model at https://console.bodhan.ai/
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_OCR_KEY=<your indic-ocr key>

# Planner LLM: any OpenAI-compatible endpoint that supports tool calling.
LLM_BASE_URL=<https://your-provider.example/v1>
LLM_MODEL=<model id with tool calling>
LLM_API_KEY=<your LLM key>

# Note for the cookbook validator: this recipe does NOT read BODHAN_API_KEY.
# The assignment requires one key per model (the four variables above) and no other secrets.
