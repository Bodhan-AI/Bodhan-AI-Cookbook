# The Cookbook template names BODHAN_API_KEY; it is NOT used by this assignment.
# Only the four model-specific Bodhan keys below and LLM_API_KEY are read.
# Keys are per model. Never put real values in version control.
BODHAN_TRANSCRIBE_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_OCR_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional verified provider-specific INR rates. If absent: explicit assumed 1000/3000.
# Unknown-provider defaults are accounting assumptions, NOT a guaranteed external charge cap.
# Include FX/taxes where relevant, using conservative upper-bound rates.
LLM_INPUT_INR_PER_MILLION=
LLM_OUTPUT_INR_PER_MILLION=
# Default max_tokens; set only if provider needs another OpenAI-compatible cap field.
LLM_TOKEN_LIMIT_FIELD=max_tokens
# Independent MCP server settings (CLI agent uses --files and --out instead).
BODHAN_INPUT_ROOT=./sample_data
BODHAN_OUTPUT_ROOT=./outputs/mcp
BODHAN_MAX_COST_INR=20
BODHAN_MAX_STEPS=30
BODHAN_CALL_TIMEOUT=45
BODHAN_RUN_TIMEOUT=300
# Optional safe demos:1allows only cached successful Bodhan calls; misses never dispatch.
# Planner requests are NOT disabled. Preserve original billed-call provenance.
BODHAN_CACHE_ONLY=0
