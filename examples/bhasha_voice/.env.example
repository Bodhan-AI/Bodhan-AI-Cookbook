# Copy this file to .env.local, then fill in your server-side keys.
# Get model access and keys at https://console.bodhan.ai/.
# Never prefix these variables with NEXT_PUBLIC_ or put keys in React props.

# Optional common fallback, if this key can access the models you use.
BODHAN_API_KEY=

# Preferred when Bodhan provides separate keys for each model.
# Transcription: this key overrides BODHAN_API_KEY.
BODHAN_TRANSCRIBE_API_KEY=

# Translation: this key overrides the transcription key and common fallback.
BODHAN_TRANSLATE_API_KEY=

# Optional absolute path to FFmpeg. Leave empty to use ffmpeg from PATH.
FFMPEG_PATH=
