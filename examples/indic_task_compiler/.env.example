# Copy to .env and fill in your credentials. Never commit .env.

# Bodhan API base URL and keys (per-model keys override BODHAN_API_KEY)
BODHAN_BASE_URL=https://api.bodhan.ai
BODHAN_API_KEY=<your-bodhan-api-key-placeholder>
BODHAN_TRANSCRIBE_KEY=<your-bodhan-transcribe-key-placeholder>
BODHAN_TRANSLATE_KEY=<your-bodhan-translate-key-placeholder>
BODHAN_SPEAK_KEY=<your-bodhan-speak-key-placeholder>
BODHAN_OCR_KEY=<your-bodhan-ocr-key-placeholder>

# OpenAI-compatible LLM endpoint for the planner (P-LLM) and quarantined reader (Q-LLM)
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=<your-llm-api-key-placeholder>

# Optional overrides
# BODHAN_CACHE_DIR=~/.cache/bodhan_mcp
# BODHAN_MAX_CONCURRENCY=4
# BODHAN_TIMEOUT_S=60
# BODHAN_DEV_LEDGER_PATH=outputs/dev_spend_ledger.json
# BODHAN_DEV_SPEND_CAP_INR=50
