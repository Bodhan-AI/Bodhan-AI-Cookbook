# Bodhan API configuration - PLACEHOLDERS ONLY
BODHAN_API_KEY=replace-with-your-key
BODHAN_TRANSLATE_KEY=replace-with-your-key
BODHAN_TRANSCRIBE_KEY=replace-with-your-key
BODHAN_SPEAK_KEY=replace-with-your-key
BODHAN_OCR_KEY=replace-with-your-key

BODHAN_BASE_URL=https://api.bodhan.ai

# General-purpose LLM
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=replace-with-model-name
LLM_API_KEY=replace-with-your-key

BODHAN_WORKSPACE=.
