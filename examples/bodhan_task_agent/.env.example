# Copy to .env and fill in. Never commit .env.

# --- Bodhan models (one key per model, from https://console.bodhan.ai) ---
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key>
BODHAN_TRANSLATE_KEY=<your indic-translate key>
BODHAN_SPEAK_KEY=<your indic-speak key>
BODHAN_OCR_KEY=<your indic-ocr key>
# Optional: a single key used for any model whose per-model key above is unset (Cookbook convention).
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>
BODHAN_BASE_URL=https://api.bodhan.ai

# --- The agent's LLM (any OpenAI-compatible endpoint with tool calling) ---
LLM_BASE_URL=<https://your-llm-provider/v1>
LLM_MODEL=<model name>
LLM_API_KEY=<your LLM key>
# LLM_MAX_TOKENS=4096           # output cap per LLM call (dropped automatically if the provider rejects it)

# --- Optional tuning (defaults shown) ---
# BODHAN_CACHE_DIR=~/.cache/bodhan_mcp
# BODHAN_MAX_CONCURRENCY=4
# BODHAN_MAX_RETRIES=4
# BODHAN_MCP_WORKDIR=./bodhan_mcp_outputs
# BODHAN_MCP_ALLOWED_DIRS=          # allowlist separated by ":" (Linux/macOS) or ";" (Windows) for file access; empty = unrestricted
# BODHAN_MCP_TOKEN=                 # bearer token for the optional streamable-HTTP transport
