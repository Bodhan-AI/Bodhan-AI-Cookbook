# Bodhan API key from https://console.bodhan.ai/ (used for all four models)
BODHAN_API_KEY=your-bodhan-key
# Optional per-model keys; each overrides BODHAN_API_KEY for its model
# BODHAN_TRANSCRIBE_KEY=
# BODHAN_TRANSLATE_KEY=
# BODHAN_SPEAK_KEY=
# BODHAN_OCR_KEY=

# LLM for the task agent (any OpenAI-compatible endpoint with tool calling)
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model
LLM_API_KEY=your-llm-key

# File access for MCP tools. Tools read only from INPUT_DIR, OUTPUT_DIR and
# ALLOWED_DIRS (separated by ':' on Linux/macOS, ';' on Windows), and write only to OUTPUT_DIR.
# BODHAN_MCP_INPUT_DIR=./inputs
# BODHAN_MCP_OUTPUT_DIR=./outputs/mcp
# BODHAN_MCP_ALLOWED_DIRS=/data/task_inputs:/home/me/media

# Optional server tuning
# BODHAN_BASE_URL=https://api.bodhan.ai
# BODHAN_MAX_CONCURRENCY=4
# BODHAN_REQUESTS_PER_MINUTE=100
# BODHAN_TIMEOUT_S=60
# BODHAN_MAX_RETRIES=3
# BODHAN_TRANSLATE_CHUNK_CHARS=2000
# BODHAN_TRANSLATE_PARALLEL_CHUNKS=4
# BODHAN_TOOL_DEADLINE_S=240
# BODHAN_MAX_INPUT_CHARS=200000
# BODHAN_INLINE_TEXT_LIMIT=4000
# BODHAN_TRANSCRIBE_MAX_DURATION_S=1800
# BODHAN_TRANSCRIBE_MAX_FILE_MB=200
# BODHAN_SPEAK_REQUESTS_PER_MINUTE=6
# BODHAN_OCR_MAX_PAGES=20

# Result cache: successful Bodhan results are reused instead of paying for the same call twice.
# It stores copies of your text, transcripts and audio on disk; BODHAN_CACHE=off stops new writes
# but does not delete existing files.
# BODHAN_CACHE=on
# BODHAN_CACHE_DIR=./.cache/bodhan
# BODHAN_CACHE_TTL_DAYS=7
# BODHAN_MCP_LOG_LEVEL=INFO
# BODHAN_MCP_LOG_FILE=./outputs/mcp/server.log
