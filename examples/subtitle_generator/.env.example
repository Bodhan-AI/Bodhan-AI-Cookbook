# Copy to .env and fill in. Never commit .env.
# Bodhan keys work with one model each: create one per model on console.bodhan.ai.
BODHAN_TRANSCRIBE_API_KEY=<your indic-transcribe key>
# Needed only to translate subtitles
BODHAN_TRANSLATE_API_KEY=<your indic-translate key>

BODHAN_BASE_URL=https://api.bodhan.ai
# Optional: a key that works with every model, used for any key above left empty
BODHAN_API_KEY=

# true = try the app without a key (canned transcripts and translations, no Bodhan calls)
DEV_MOCK_MODE=false

MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=900
# Longest audio piece per indic-transcribe request, in seconds (the API accepts about 30)
CHUNK_SECONDS=24
# true = ask indic-transcribe for word timestamps (OpenAI verbose_json). The API accepts this but
# returns no timings yet; once it does, subtitles use the real times instead of estimates.
BODHAN_TIMESTAMPS=false

# Optional: use this ffmpeg instead of the one pip installs with imageio-ffmpeg
FFMPEG_PATH=

# Where job history is kept. Empty = SQLite file backend/data/subtitles.db.
# Postgres: postgresql+psycopg://user:password@localhost/subtitles (then pip install psycopg)
DATABASE_URL=

# Start jobs from a link instead of an upload. Two separate switches; both off by default.
# true = a direct link to a video file, e.g. https://example.com/talk.mp4
DIRECT_VIDEO_LINKS=false
# true = a YouTube video link (downloaded with yt-dlp; the page also asks the user to allow it, each visit).
# Use only videos you have the right to use. If YouTube links stop working: pip install -U yt-dlp
YOUTUBE_LINKS=false
