# Copy to .env and fill in. Never commit .env.

# Bodhan hosted API
BODHAN_BASE_URL=https://api.bodhan.ai
BODHAN_OCR_KEY=<ocr key from console.bodhan.ai>
BODHAN_TRANSLATE_KEY=<translate key from console.bodhan.ai>
BODHAN_SPEAK_KEY=<speak key from console.bodhan.ai>
BODHAN_TRANSCRIBE_KEY=<transcribe key from console.bodhan.ai>

# Optional fallback used only if BODHAN_OCR_KEY is unset
# BODHAN_API_KEY=<single key if your console issued one shared key>

# General-purpose LLM (OpenAI-compatible), e.g. Gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=<your llm api key>
