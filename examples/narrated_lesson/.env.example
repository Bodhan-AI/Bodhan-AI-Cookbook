# Copy to .env and fill in. Never commit .env.

# Bodhan hosted API (https://console.bodhan.ai)
BODHAN_BASE_URL=https://api.bodhan.ai

# Prefer one key per product. Any missing product key falls back to BODHAN_API_KEY.
BODHAN_OCR_KEY=<ocr key>
BODHAN_TRANSLATE_KEY=<translate key>
BODHAN_SPEAK_KEY=<speak key>
BODHAN_TRANSCRIBE_KEY=<transcribe key>

# Shared fallback (optional) — used when a product-specific key above is unset
BODHAN_API_KEY=<shared key if your console issued only one>

# General-purpose LLM (OpenAI-compatible) for layout repair + narration
# Example: Gemini OpenAI-compat endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=<your llm api key>

# Parallel languages for translate/narrate/speak/qa (I/O-bound; default 3, max 8)
# LANG_WORKERS=3
