# Copy to .env and fill in. Never commit .env.
BODHAN_API_KEY=<your Bodhan API key from console.bodhan.ai>

# Per-model API keys (preferred for tool server/agent)
BODHAN_TRANSCRIBE_KEY=<your indic-transcribe key from console.bodhan.ai>
BODHAN_TRANSLATE_KEY=<your indic-translate key from console.bodhan.ai>
BODHAN_SPEAK_KEY=<your indic-speak key from console.bodhan.ai>
BODHAN_OCR_KEY=<your indic-ocr key from console.bodhan.ai>

# Companion LLM for planning (OpenAI-compatible endpoint)
LLM_BASE_URL=<https://api.openai.com/v1 or your provider>
LLM_MODEL=<gpt-4o-mini or your choice>
LLM_API_KEY=<your LLM key>
