# Bodhan AI API credentials (from https://console.bodhan.ai)
# Bodhan console issues API keys per model. Configure model-specific keys:
BODHAN_OCR_API_KEY=your_bodhan_ocr_api_key_here
BODHAN_TRANSLATE_API_KEY=your_bodhan_translate_api_key_here

# Alternatively, use BODHAN_API_KEY as a unified backward-compatible key:
# BODHAN_API_KEY=your_bodhan_api_key_here

# Groq API configuration (for answer generation in RAG)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Multilingual Embedding configuration (independent of Groq)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Optional Tokenizer-Aware Chunking parameters (E5 512-token max sequence limit)
# MAX_CHUNK_TOKENS=480
# CHUNK_TOKEN_OVERLAP=40
# MAX_QUERY_TOKENS=512

# Optional OpenAI alternative:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=your_openai_api_key_here

# Optional RAG parameters
# TOP_K=4
# TEMPERATURE=0.0
