# Bodhan AI API credentials (from https://console.bodhan.ai)
# Use BODHAN_API_KEY for a unified key, or model-scoped keys if separately provisioned:
BODHAN_API_KEY=your_bodhan_api_key_here
# BODHAN_OCR_API_KEY=your_bodhan_ocr_key_here
# BODHAN_TRANSLATION_API_KEY=your_bodhan_translation_key_here

# Groq API configuration (for answer generation in RAG)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Multilingual Embedding configuration (independent of Groq)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional RAG parameters
# TOP_K=4
# TEMPERATURE=0.0
