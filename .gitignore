# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# Node (for JS/TS recipes)
node_modules/
.next/

# Recipe outputs and large local data
examples/*/outputs/*
!examples/*/outputs/.gitkeep
examples/*/sample_data/*
!examples/*/sample_data/.gitkeep

# OS / IDE
.DS_Store
.vscode/
.idea/
